<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="model.dao.MenuMapper">

    <resultMap id="MenuMapper" type="MenuDTO">
        <id property="menuCode" column="MENU_CODE"/>
        <result property="menuName" column="MENU_NAME"/>
        <result property="menuPrice" column="MENU_PRICE"/>
        <result property="categoryCode" column="CATEGORY_CODE"/>
        <result property="orderableStatus" column="ORDERABLE_STATUS"/>
    </resultMap>

    <select id="selectAllMenu" resultMap="MenuMapper">
        SELECT
            *
        FROM
            TBL_MENU
    </select>

    <select id="selectByMenuPrice" parameterType="MenuDTO" resultMap="MenuMapper">
        SELECT
            *
        FROM
            TBL_MENU
        WHERE
            ORDERABLE_STATUS = 'Y'
            <if test="menuPrice gte 0 and menuPrice lte 10000">
                AND MENU_PRICE BETWEEN 0 AND #{menuPrice}
            </if>
            <if test="menuPrice gt 10000 and menuPrice lte 20000">
                AND MENU_PRICE BETWEEN 10000 AND #{menuPrice}
            </if>
            <if test="menuPrice gt 20000 and menuPrice lte 30000">
                AND MENU_PRICE BETWEEN 20000 AND #{menuPrice}
            </if>
            <if test="menuPrice gt 30000">
                AND MENU_PRICE BETWEEN 30000 AND #{menuPrice}
            </if>
    </select>

    <insert id="inputNewMenu" parameterType="MenuDTO">
        INSERT INTO TBL_MENU(MENU_NAME, MENU_PRICE, CATEGORY_CODE, ORDERABLE_STATUS)
        VALUES(#{menuName} , #{menuPrice}, #{categoryCode}, 'Y')
    </insert>

    <update id="modifyMenu" parameterType="hashmap">
        UPDATE TBL_MENU
        <trim prefix="SET" prefixOverrides=",">
            <if test="menuName != null and menuName != ''">
                MENU_NAME = #{menuName}
            </if>
            <if test="menuPrice != null and menuPrice != ''">
                , MENU_PRICE = #{menuPrice}
            </if>
            <if test="categoryCode != null and categoryCode != ''">
                , CATEGORY_CODE = #{categoryCode}
            </if>
            <if test="orderableStatus != null and orderableStatus != ''">
                , ORDERABLE_STATUS = #{orderableStatus}
            </if>
        </trim>
        WHERE
            MENU_CODE = #{menuCode}
    </update>

    <delete id="deleteMenu" parameterType="hashmap">
        DELETE FROM TBL_MENU
        WHERE MENU_CODE = #{menuCode}
    </delete>

    <select id="selectRandomMenu" parameterType="hashmap" resultMap="MenuMapper">
        SELECT
            *
        FROM
            TBL_MENU
        WHERE
            MENU_CODE IN
        <foreach collection="selectRandomMenu" item="menuList" open="(" close=")" separator=",">
            #{menuList}
        </foreach>

    </select>
</mapper>